note synapse-board src/20-emit.om -- BOARD.md (w 0) and index.html (w 1) from the indexed inputs.
note Every input byte goes through sbesc (Markdown or HTML escaping); links only for safe http(s) URLs.
text h1md "# AIEN coordination board\n\n> Generated file. Do not edit. Agents write through synapse-claims; this page is rebuilt from the claims ledger, the repo map and pulse findings.\n\n"
text h1ht "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'none'; style-src 'unsafe-inline'\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>AIEN coordination board</title>\n<style>\nbody{font:14px/1.45 system-ui,sans-serif;margin:1.5em auto;max-width:72em;padding:0 1em;color:#1b1b1b;background:#fff}\ntable{border-collapse:collapse;width:100%;margin:.5em 0 1.5em}\nth,td{border:1px solid #ccc;padding:.25em .45em;text-align:left;vertical-align:top}\nth{background:#f2f2f2}\n.note{background:#fff8d6;border:1px solid #e0d38a;padding:.5em .8em}\n.inf{color:#8a4b00;font-weight:600}\n.lap{color:#a00;font-weight:600}\nul.map{list-style:none;padding-left:0}\n.d1{margin-left:1.5em}.d2{margin-left:3em}.d3{margin-left:4.5em}.d4{margin-left:6em}.d5{margin-left:7.5em}.d6{margin-left:9em}.d7{margin-left:10.5em}.d8{margin-left:12em}.d9{margin-left:13.5em}\n</style>\n</head>\n<body>\n<h1>AIEN coordination board</h1>\n<p class=\"note\">Generated file. Do not edit. Agents write through synapse-claims; this page is rebuilt from the claims ledger, the repo map and pulse findings.</p>\n"
text tgen1 "Generated by synapse-board from ledger head "
text tgen2 " at "
text tunk "unknown"
text tpmd "_"
text tpe "_\n\n"
text tpht "<p><small>"
text tpht2 "</small></p>\n"
text s1md "## Summary\n\n"
text s1ht "<h2>Summary</h2>\n<ul>\n"
text s1end "</ul>\n"
text lact "active claims: "
text llap "active but past expiry (lapsed): "
text lina "inactive claims (released or expired): "
text lrep "repos with active claims: "
text lcnf "conflicts: "
text lerr "findings, error: "
text lwrn "findings, warn: "
text linf "findings, info: "
text lmap "repos in map: "
text lpin "INFERRED parents: "
text mdli "- "
text htli "<li>"
text htlie "</li>\n"
text s2md "\n## Conflicts\n\n"
text s2ht "<h2>Conflicts</h2>\n"
text s3md "\n## Pulse findings\n\n"
text s3ht "<h2>Pulse findings</h2>\n"
text s4md "\n## Active claims\n\n"
text s4ht "<h2>Active claims</h2>\n"
text s5md "\n## Repo map\n\n"
text s5ht "<h2>Repo map</h2>\n"
text nonemd "_none_\n"
text noneht "<p>none</p>\n"
text c2md "| severity | target | agent | id | other agent | other id | detail |\n|---|---|---|---|---|---|---|\n"
text c2ht "<table>\n<thead><tr><th>severity</th><th>target</th><th>agent</th><th>id</th><th>other agent</th><th>other id</th><th>detail</th></tr></thead>\n<tbody>\n"
text c3md "| kind | severity | repo | target | agent | session | pr | path | detail |\n|---|---|---|---|---|---|---|---|---|\n"
text c3ht "<table>\n<thead><tr><th>kind</th><th>severity</th><th>repo</th><th>target</th><th>agent</th><th>session</th><th>pr</th><th>path</th><th>detail</th></tr></thead>\n<tbody>\n"
text c4md "| agent | target | mode | state | intent | expires | evidence |\n|---|---|---|---|---|---|---|\n"
text c4ht "<table>\n<thead><tr><th>agent</th><th>target</th><th>mode</th><th>state</th><th>intent</th><th>expires</th><th>evidence</th></tr></thead>\n<tbody>\n"
text tbeht "</tbody>\n</table>\n"
text rsmd "|"
text rsht "<tr>"
text remd "\n"
text reht "</tr>\n"
text cemd " "
text cemd2 " |"
text cht "<td>"
text chte "</td>"
text g4md "\n### "
text g4ht "<h3>"
text g4hte "</h3>\n"
text gext "external"
text gunp "(unparsed)"
text tlap " LAPSED"
text tlapht " <span class=\"lap\">LAPSED</span>"
