text tfoot "</body>\n</html>\n"
note ---- small pieces
fn sbsum lab view uchar * v ulong to void
sbraw 0 mdli
sbraw 1 htli
sbr2 lab
sbn2 v
sbraw 0 tnl
sbraw 1 htlie
end
fn sbrow0 to void
sbraw 0 rsmd
sbraw 1 rsht
end
fn sbrow1 to void
sbraw 0 remd
sbraw 1 reht
end
fn sbc0 to void
sbraw 0 cemd
sbraw 1 cht
end
fn sbc1 to void
sbraw 0 cemd2
sbraw 1 chte
end
note sbcell: one table cell holding the escaped string value of key
fn sbcell lb view uchar 65536 tp view uint 16400 sb edit uchar 65536 key view uchar * to void
sbc0
n = sbgets lb tp sb key
if gt n 0
sbe2 sb ulong n
end
sbc1
end
fn sbcelln v ulong to void
sbc0
if gt v 0
sbn2 v
end
sbc1
end
fn sbtblend to void
sbraw 0 tnl
sbraw 1 tbeht
end
fn sbnone to void
sbraw 0 nonemd
sbraw 1 noneht
end
note sburlok: http(s) URL whose every byte is in the safe set
fn sburlok sb view uchar 65536 n ulong to bool
p = ulong 0
if and ge n 8 sbpre sb thttps
p = 8
end
if and eq p 0 and ge n 7 sbpre sb thttp
p = 7
end
if or eq p 0 ge p n
ret false
end
for i ulong n
c = get sb i
ok = or or and ge c 97 le c 122 and ge c 65 le c 90 and ge c 48 le c 57
if not ok
ok = sbsafe c
end
if not ok
ret false
end
end
ret true
end
fn sbpre sb view uchar 65536 t view uchar * to bool
for i ulong len t
if ne get sb i get t i
ret false
end
end
ret true
end
note sbsafe: URL punctuation allowed in a link  - . _ ~ : / ? # [ ] @ ! $ & * + , ; = %
fn sbsafe c uchar to bool
if or or or eq c 45 eq c 46 or eq c 95 eq c 126 or or eq c 58 eq c 47 or eq c 63 eq c 35
ret true
end
if or or or eq c 91 eq c 93 or eq c 64 eq c 33 or or eq c 36 eq c 38 or eq c 42 eq c 43
ret true
end
ret or or eq c 44 eq c 59 or eq c 61 eq c 37
end
note sblink: one evidence entry: a link when safe, else escaped text
fn sblink sb view uchar 65536 n ulong to void
if sburlok sb n
sbraw 0 tamd1
sbesc 0 sb n
sbraw 0 tamd2
sbraw 1 taht1
sbesc 1 sb n
sbraw 1 taht2
sbesc 1 sb n
sbraw 1 taht3
ret
end
sbe2 sb n
end
fn sbevid lb view uchar 65536 tp view uint 16400 sb edit uchar 65536 to void
sbc0
v = sbkey lb tp kev
if ne v jsnone
if eq js_type tp v jsarr
e = js_first tp v
k = ulong 0
for it ulong 4096
if eq e jsnone
break
end
if eq js_type tp e jsstr
n = js_sget lb js_off tp e sb
if gt n 0
if gt k 0
sbraw 0 tevmd
sbraw 1 tevht
end
sblink sb ulong n
k = add k 1
end
end
e = js_enext tp e
end
end
end
sbc1
end
note ======== header, generated-by line and summary
fn sbhead to void
sbraw 0 h1md
sbraw 1 h1ht
sbraw 0 tpmd
sbraw 1 tpht
sbr2 tgen1
n = get gplen 5
if eq n 0
sbr2 tunk
else
for i ulong n
sbesc1 0 sbslotc 5 i
end
for j ulong n
sbesc1 1 sbslotc 5 j
end
end
sbr2 tgen2
m = get gnowl 0
for k ulong m
sbesc1 0 get gnow k
end
for k2 ulong m
sbesc1 1 get gnow k2
end
sbraw 0 tpe
sbraw 1 tpht2
sbraw 0 s1md
sbraw 1 s1ht
sbsum lact get gcnt 0
sbsum llap get gcnt 1
sbsum lina get gcnt 2
sbsum lrep get gcnt 3
sbsum lcnf get gcnt 4
sbsum lerr get gcnt 5
sbsum lwrn get gcnt 6
sbsum linf get gcnt 7
sbsum lmap get gcnt 8
sbsum lpin get gcnt 9
sbraw 1 s1end
end
note ======== findings: conflicts (cf true) or the other pulse findings (cf false)
fn sbfind cf bool to void
lb = new uchar 65536 0
tp = new uint 16400 0
sb = new uchar 65536 0
if cf
sbraw 0 s2md
sbraw 1 s2ht
if eq get gcnt 4 0
sbnone
ret
end
sbraw 0 c2md
sbraw 1 c2ht
else
sbraw 0 s3md
sbraw 1 s3ht
if eq get gcnt 10 0
sbnone
ret
end
sbraw 0 c3md
sbraw 1 c3ht
end
tot = get glen 2
off = ulong 0
for it ulong SBLINES
if ge off tot
break
end
n = sbpl 2 off lb tp
if lt n 0
break
end
if gt n 0
k = sbgets lb tp sb kkind
isc = sbeqv sb k vconf
if eq isc cf
sbrow0
if cf
sbcell lb tp sb ksev
sbcell lb tp sb ktgt
sbcell lb tp sb kagent
sbcell lb tp sb kid
sbcell lb tp sb koag
sbcell lb tp sb koid
sbcell lb tp sb kdet
else
sbcell lb tp sb kkind
sbcell lb tp sb ksev
sbcell lb tp sb krepo
sbcell lb tp sb ktgt
sbcell lb tp sb kagent
sbcell lb tp sb ksess
sbcelln sbgetu lb tp kpr
sbcell lb tp sb kpath
sbcell lb tp sb kdet
end
sbrow1
end
end
off = add add off ulong n 1
end
sbtblend
end
note ======== active claims grouped by repo key
fn sbgroup c ulong to void
sbraw 0 g4md
sbraw 1 g4ht
r = get gkrk c
if eq r 1
sbr2 gext
end
if eq r 2
sbr2 gunp
end
if eq r 0
o = get gkoff c
for i ulong get gkln c
sbesc1 0 get gpool add o i
end
for j ulong get gkln c
sbesc1 1 get gpool add o j
end
end
sbraw 0 tnl
sbraw 1 g4hte
sbraw 0 tnl
sbraw 0 c4md
sbraw 1 c4ht
end
fn sbclaims to void
lb = new uchar 65536 0
tp = new uint 16400 0
sb = new uchar 65536 0
sbraw 0 s4md
sbraw 1 s4ht
nc = get gnc 0
if eq nc 0
sbnone
ret
end
for i ulong nc
c = get gord i
if eq i 0
sbgroup c
else
if not sbkeyeq get gord sub i 1 c
sbraw 1 tbeht
sbgroup c
end
end
n = sbpl 0 get gcoff c lb tp
sbrow0
sbcell lb tp sb kagent
sbcell lb tp sb ktgt
sbcell lb tp sb kmode
sbcell lb tp sb kstate
sbcell lb tp sb kint
sbc0
e = sbgets lb tp sb kexp
if gt e 0
sbe2 sb ulong e
end
if eq get glap c 1
sbraw 0 tlap
sbraw 1 tlapht
end
sbc1
sbevid lb tp sb
sbrow1
end
sbraw 1 tbeht
end
note ======== repo map tree (iterative depth-first, file order among siblings)
fn sbnode m ulong d ulong cyc bool to void
lb = new uchar 65536 0
tp = new uint 16400 0
sb = new uchar 65536 0
put gmvis m 1
n = sbpl 1 get gmoff m lb tp
for i ulong d
sbraw 0 tsp2
end
sbraw 0 mdli
sbraw 0 tbold
sbraw 1 tli1
dd = d
if gt dd 9
dd = 9
end
sbnum 1 dd
sbraw 1 tli2
sbraw 1 tb1
o = get gmno m
for j ulong get gmnl m
sbesc1 0 get gpool add o j
end
for j2 ulong get gmnl m
sbesc1 1 get gpool add o j2
end
sbraw 0 tbold
sbraw 1 tb2
st = get gmst m
if eq st 1
sbraw 0 tinfmd
sbraw 1 tinfht
sbfld 0 lb tp sb krule
sbfld 1 lb tp sb krule
sbraw 0 tclose
sbraw 1 tcloseh
end
if eq st 2
sbr2 troot
end
if eq st 3
sbr2 tnone
end
if and gt get gmpl m 0 eq get gmpar m jsnone
sbr2 tpout
sbfld 0 lb tp sb kpar
sbfld 1 lb tp sb kpar
sbr2 tclose
end
if sbgetb lb tp karch
sbr2 tarch
end
if sbgetb lb tp kfork
sbr2 tfork
end
if cyc
sbr2 tcyc
end
k = sbgets lb tp sb kpurp
if gt k 0
sbr2 tdash
sbe2 sb ulong k
end
sbraw 0 tnl
sbraw 1 htlie
end
note sbtree: print root r and its descendants; nodes already printed are skipped (cycle guard)
fn sbtree r ulong cyc bool to void
nm = get gnm 0
put gstk 0 r
put gsdp 0 0
sp = ulong 1
for it ulong 999999
if eq sp 0
ret
end
sp = sub sp 1
m = get gstk sp
d = get gsdp sp
if eq get gmvis m 0
sbnode m d and cyc eq it 0
for i ulong nm
c = sub sub nm 1 i
if and eq get gmpar c m eq get gmvis c 0
if lt sp SBMAXM
put gstk sp c
put gsdp sp add d 1
sp = add sp 1
end
end
end
end
end
end
fn sbmap to void
sbraw 0 s5md
sbraw 1 s5ht
nm = get gnm 0
if eq nm 0
sbnone
ret
end
sbraw 1 ulmap
for i ulong nm
if eq get gmpar i jsnone
sbtree i false
end
end
for j ulong nm
if eq get gmvis j 0
sbtree j true
end
end
sbraw 1 s1end
end
fn sbemit to void
sbhead
sbfind true
sbfind false
sbclaims
sbmap
sbraw 1 tfoot
end
